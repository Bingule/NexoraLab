    "react-dom": "^19.3.0",
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "@types/katex": "0.16.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "25.0.1",
    "typescript": "^7.0.2",
    "vitest": "3.2.6"
